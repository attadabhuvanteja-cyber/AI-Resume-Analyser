# AI Resume Analyzer Configuration

# Port for the Express server (default: 3001)
PORT=3001

# Anthropic API Key (Optional)
# If provided, Claude will provide AI-powered skill extraction, strengths, tailored suggestions, and custom summary.
# If omitted or invalid, the app runs in 100% deterministic keyword and rule-based fallback mode.
ANTHROPIC_API_KEY=

# Anthropic Model (Default: claude-sonnet-5 or claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=claude-sonnet-5
